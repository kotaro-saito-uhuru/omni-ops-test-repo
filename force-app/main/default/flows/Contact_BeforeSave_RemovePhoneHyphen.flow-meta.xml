<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Phone_Without_Hyphen</name>
        <label>Phone からハイフンを削除</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Phone_Without_Hyphen</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Contact の Phone に半角ハイフンが含まれるとき、保存前にハイフンを削除する（Issue #9）</description>
    <environments>Default</environments>
    <formulas>
        <name>Phone_Without_Hyphen</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.Phone}, &quot;-&quot;, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Contact: Phone のハイフンを削除 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact: Phone のハイフンを削除</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Phone_Without_Hyphen</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Phone</field>
            <operator>Contains</operator>
            <value>
                <stringValue>-</stringValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
